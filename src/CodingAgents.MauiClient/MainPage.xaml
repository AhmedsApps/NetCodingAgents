<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CodingAgents.MauiClient"
             xmlns:components="clr-namespace:CodingAgents.MauiClient.Components"
             x:Class="CodingAgents.MauiClient.MainPage"
             Padding="{OnPlatform Android='0,24,0,0', iOS='0,44,0,0', Default='0'}">

    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>

</ContentPage>
