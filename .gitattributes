# Normalise line endings so the repo is consistent across Windows/macOS/Linux.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.slnx      text
*.sln       text eol=crlf
*.json      text
*.razor     text
*.css       text
*.js        text
*.md        text
*.xml       text
*.yml       text
*.props     text
*.targets   text

# Binary assets
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.ttf       binary
*.otf       binary
*.pdf       binary
*.zip       binary
